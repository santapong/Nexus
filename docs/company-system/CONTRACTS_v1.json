  "scope": "Wire shapes; semantic rules also require acceptance tests",
  "contracts": {
    "CompanyMandate": {
      "additionalProperties": false,
      "description": "Owner-authored company direction; decoding is not proof of authority.",
      "properties": {
        "schema_version": {
          "const": "nexus.company.v1",
          "default": "nexus.company.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "company_id": {
          "format": "uuid",
          "title": "Company Id",
          "type": "string"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "version": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "purpose": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "goals": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "oversight": {
          "default": "supervised",
          "enum": [
            "supervised",
            "delegated",
            "board"
          ],
          "title": "Oversight",
          "type": "string"
        },
        "daily_cap_usd": {
          "anyOf": [
            {
              "maximum": 5.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "default": "5.00",
          "title": "Daily Cap Usd"
        },
        "work_cap_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,19}0*$)\\d{0,12}\\.\\d{0,6}0*$)",
              "type": "string"
            }
          ],
          "default": "1.00",
          "title": "Work Cap Usd"
        },
        "self_improvement_enabled": {
          "const": false,
          "default": false,
          "title": "Self Improvement Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "company_id",
        "owner_id",
        "version",
        "purpose"
      ],
      "title": "CompanyMandate",
      "type": "object"
    },
